// Clinical Notes — database schema
// Owned by: backend-engineer
// Schema review by: architect, compliance-officer (PHI classification)
//
// Conventions
// - Every PHI-bearing model carries tenantId; queries are tenant-scoped via Prisma middleware in src/middleware/tenancy.ts.
// - All updates write an AuditEvent (hash-chained) via src/middleware/audit.ts.
// - Soft deletes via deletedAt where retention policy requires recovery; hard delete only via the retention engine.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, pg_trgm, vector]
}

// -------- Tenancy & users --------

enum TenantTier {
  starter
  practice
  clinic
  enterprise
}

enum DataResidency {
  us
  eu
  ca
  au
  uk
}

model Tenant {
  id            String        @id @default(uuid()) @db.Uuid
  slug          String        @unique
  name          String
  tier          TenantTier    @default(starter)
  dataResidency DataResidency @default(us)
  config        Json          @default("{}")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  users        User[]
  patients     Patient[]
  encounters   Encounter[]
  notes        Note[]
  templates    NoteTemplate[]
  integrations Integration[]
  webhooks     WebhookSubscription[]
  audits       AuditEvent[]
}

enum Role {
  admin
  clinician
  scribe_reviewer
  billing
  auditor
}

model User {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  email      String
  name       String
  roles      Role[]
  npi        String?
  specialty  String?
  passwordHash String?
  mfaSecret  String?
  ssoSubject String?
  disabledAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  encounters Encounter[] @relation("ClinicianEncounters")
  notesSigned Note[]     @relation("NotesSignedBy")

  @@unique([tenantId, email])
  @@index([tenantId, disabledAt])
}

// -------- Clinical entities --------

enum Sex {
  female
  male
  other
  unknown
}

model Patient {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  mrn          String
  givenName    String
  familyName   String
  birthDate    DateTime  @db.Date
  sex          Sex
  pronouns     String?
  contactEmail String?
  contactPhone String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  encounters Encounter[]

  @@unique([tenantId, mrn])
  @@index([tenantId, familyName, givenName])
}

enum EncounterStatus {
  scheduled
  in_progress
  awaiting_review
  signed
  amended
  cancelled
}

enum EncounterMode {
  in_person
  telehealth
  home_visit
}

model Encounter {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @db.Uuid
  patientId       String          @db.Uuid
  clinicianId     String          @db.Uuid
  status          EncounterStatus @default(scheduled)
  mode            EncounterMode   @default(in_person)
  scheduledAt     DateTime?
  startedAt       DateTime?
  endedAt         DateTime?
  reasonForVisit  String?
  templateId      String?         @db.Uuid
  audioObjectKey  String?
  audioDurationMs Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  patient   Patient        @relation(fields: [patientId], references: [id])
  clinician User           @relation("ClinicianEncounters", fields: [clinicianId], references: [id])
  template  NoteTemplate?  @relation(fields: [templateId], references: [id])
  segments  TranscriptSegment[]
  notes     Note[]

  @@index([tenantId, status])
  @@index([tenantId, clinicianId, startedAt])
}

enum SpeakerRole {
  clinician
  patient
  caregiver
  other
}

model TranscriptSegment {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @db.Uuid
  encounterId   String      @db.Uuid
  speakerLabel  String
  speakerRole   SpeakerRole
  startMs       Int
  endMs         Int
  text          String
  confidence    Float
  isFinal       Boolean     @default(false)
  embedding     Unsupported("vector(1024)")?
  createdAt     DateTime    @default(now())

  encounter Encounter @relation(fields: [encounterId], references: [id])

  @@index([tenantId, encounterId, startMs])
}

// -------- Notes & templates --------

enum NoteFormat {
  soap
  hp
  progress
  discharge
  referral
  custom
}

enum NoteStatus {
  draft
  awaiting_review
  signed
  amended
}

model NoteTemplate {
  id        String     @id @default(uuid()) @db.Uuid
  tenantId  String     @db.Uuid
  name      String
  format    NoteFormat
  specialty String?
  schema    Json
  prompt    Json
  version   Int        @default(1)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  encounters Encounter[]

  @@unique([tenantId, name, version])
}

model Note {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @db.Uuid
  encounterId  String     @db.Uuid
  format       NoteFormat
  status       NoteStatus @default(draft)
  templateId   String?    @db.Uuid
  sections     Json
  codes        Json       @default("[]")
  signedById   String?    @db.Uuid
  signedAt     DateTime?
  generatedAt  DateTime   @default(now())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  encounter Encounter @relation(fields: [encounterId], references: [id])
  signedBy  User?     @relation("NotesSignedBy", fields: [signedById], references: [id])

  @@index([tenantId, encounterId])
  @@index([tenantId, status])
}

// -------- Integrations & webhooks --------

enum IntegrationKind {
  fhir
  hl7v2
  epic
  cerner
  athenahealth
  drchrono
}

model Integration {
  id        String          @id @default(uuid()) @db.Uuid
  tenantId  String          @db.Uuid
  kind      IntegrationKind
  name      String
  config    Json
  enabled   Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
}

model WebhookSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  url       String
  events    String[]
  secret    String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, enabled])
}

// -------- Audit (hash-chained) --------

enum AuditActorType {
  user
  service
  system
}

enum AuditAction {
  read
  create
  update
  delete
  sign
  amend
  export
  login
  logout
  config_change
}

enum AuditResource {
  tenant
  user
  patient
  encounter
  transcript
  note
  integration
  webhook
  audit
}

model AuditEvent {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @db.Uuid
  actorId     String?        @db.Uuid
  actorType   AuditActorType
  action      AuditAction
  resource    AuditResource
  resourceId  String
  ip          String?
  userAgent   String?
  metadata    Json           @default("{}")
  prevHash    String?
  hash        String
  occurredAt  DateTime       @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, occurredAt])
  @@index([tenantId, resource, resourceId])
}
