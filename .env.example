# Copy to .env and fill in. Never commit .env.

# --- Core ---
NODE_ENV=development
APP_ENV=development

# --- Database ---
DATABASE_URL=postgres://clinical:clinical@localhost:5432/clinical
REDIS_URL=redis://localhost:6379

# --- Object storage (audio) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345
S3_BUCKET_AUDIO=clinical-audio

# --- Auth ---
AUTH_SECRET=replace-me-with-a-long-random-string
AUTH_TRUST_HOST=true

# --- LLM provider (server-side; per-tenant overrides supersede) ---
ANTHROPIC_API_KEY=

# --- Transcription provider fallback (Deepgram) ---
DEEPGRAM_API_KEY=

# --- Service URLs (for inter-service calls) ---
API_URL=http://localhost:3001
TRANSCRIPTION_SVC_URL=http://localhost:8001
NOTES_SVC_URL=http://localhost:8002

# --- Public URLs (browser) ---
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# --- FHIR sandbox ---
FHIR_SANDBOX_URL=http://localhost:8080/fhir

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
